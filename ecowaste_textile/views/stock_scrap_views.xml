<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_scrap_form_ecowaste" model="ir.ui.view">
        <field name="name">stock.scrap.form.ecowaste</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <!-- SEMAINE 3 et 5 : caractérisation et recommandation -->
                <group string="EcoWaste Textile">
                    <group string="Caractéristiques du déchet">
                        <field name="textile_material" readonly="treatment_status != 'pending'"/>
                        <field name="waste_origin" readonly="treatment_status != 'pending'"/>
                        <field name="waste_cause" readonly="treatment_status != 'pending'"/>
                        <field name="textile_quality" readonly="treatment_status != 'pending'"/>
                        <field name="scrap_size" readonly="treatment_status != 'pending'"/>
                    </group>
                    <group string="État et valorisation">
                        <field name="textile_condition" readonly="treatment_status != 'pending'"/>
                        <field name="hazard_level" readonly="treatment_status != 'pending'"/>
                        <field name="recovery_recommendation" readonly="1"/>
                        <!-- Recalcul facultatif après modification des règles. -->
                        <button name="action_recommend_recovery"
                                string="Actualiser la recommandation"
                                type="object"
                                class="btn-secondary"
                                invisible="state != 'draft' or treatment_status != 'pending'"/>
                    </group>
                </group>

                <!-- SEMAINE 4 : traitement final décidé par un responsable -->
                <group string="Suivi du traitement">
                    <group string="Décision de traitement">
                        <field name="final_treatment"
                               readonly="treatment_status != 'pending'"/>
                        <field name="treatment_status" readonly="1"/>
                        <field name="treatment_responsible_id" readonly="1"/>
                    </group>
                    <group string="Traçabilité">
                        <field name="treatment_date" readonly="1"/>
                        <field name="treatment_justification"
                               readonly="treatment_status != 'pending'"/>
                    </group>
                    <group string="Actions de traitement" colspan="2">
                        <button name="action_validate_treatment"
                                string="Valider le traitement"
                                type="object"
                                class="btn-primary"
                                invisible="treatment_status != 'pending'"/>
                        <button name="action_complete_treatment"
                                string="Marquer comme réalisé"
                                type="object"
                                class="btn-secondary"
                                invisible="treatment_status != 'validated'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
