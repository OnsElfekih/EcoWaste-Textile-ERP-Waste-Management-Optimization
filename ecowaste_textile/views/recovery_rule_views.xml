<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_recovery_rule_tree" model="ir.ui.view">
        <field name="name">ecowaste.recovery.rule.tree</field>
        <field name="model">ecowaste.recovery.rule</field>
        <field name="arch" type="xml">
            <tree string="Règles de valorisation">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="textile_material"/>
                <field name="textile_quality"/>
                <field name="hazard_level"/>
                <field name="recommendation"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Formulaire d'une règle -->
    <record id="view_recovery_rule_form" model="ir.ui.view">
        <field name="name">ecowaste.recovery.rule.form</field>
        <field name="model">ecowaste.recovery.rule</field>
        <field name="arch" type="xml">
            <form string="Règle de valorisation">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>

                    <group string="Critères de sélection">
                        <group>
                            <field name="textile_material"/>
                            <field name="waste_origin"/>
                            <field name="waste_cause"/>
                            <field name="textile_quality"/>
                        </group>
                        <group>
                            <field name="scrap_size"/>
                            <field name="textile_condition"/>
                            <field name="hazard_level"/>
                        </group>
                    </group>

                    <group string="Décision">
                        <field name="recommendation"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action d'ouverture -->
    <record id="action_recovery_rules" model="ir.actions.act_window">
        <field name="name">Règles de valorisation</field>
        <field name="res_model">ecowaste.recovery.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu principal -->
    <menuitem
        id="menu_ecowaste_root"
        name="EcoWaste"
        sequence="50"
        groups="base.group_system"
    />

    <!-- Sous-menu -->
    <menuitem
        id="menu_recovery_rules"
        name="Règles de valorisation"
        parent="menu_ecowaste_root"
        action="action_recovery_rules"
        sequence="10"
        groups="base.group_system"
    />

</odoo>
